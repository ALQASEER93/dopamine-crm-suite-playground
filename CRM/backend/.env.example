APP_ENV=development
DPM_ENV=development
DATABASE_URL=sqlite:///./data/fastapi.db
PROD_DATABASE_URL=
ECHO_SQL=false
PROD_ECHO_SQL=
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_ISSUER=
JWT_AUDIENCE=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# ALLOWED_ORIGINS=https://<cloudflare-pages-project>.pages.dev,https://<custom-domain>
# ALLOWED_ORIGIN_REGEX=^https://<cloudflare-pages-project>(?:-[a-z0-9-]+)?\.pages\.dev$
# Vercel + Aiven pilot example:
# DPM_ENV=production
# DATABASE_URL=postgresql://<aiven-user>:<aiven-password>@<aiven-host>:<port>/<database>?sslmode=require
# PROD_DATABASE_URL=postgresql://<aiven-user>:<aiven-password>@<aiven-host>:<port>/<database>?sslmode=require
# JWT_SECRET=<strong random secret>
# SEED_DEFAULT_USERS=false
# ALLOW_DEV_TOKEN_ENDPOINT=false
# ALLOW_DEV_TOKEN=false
SEED_DEFAULT_USERS=true
BOOTSTRAP_CODE=
DPM_BOOTSTRAP_ADMIN_ONCE=false
DPM_BOOTSTRAP_ADMIN_EMAIL=
DPM_BOOTSTRAP_ADMIN_PASSWORD=
DPM_BOOTSTRAP_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_RESET=false
GPS_MAX_DISTANCE_M=100
GPS_MIN_ACCURACY_M=80
ALLOW_GPS_OVERRIDE=true
GEOFENCE_RADIUS_M=120
GEOFENCE_REQUIRE_TARGET_COORDS=false
