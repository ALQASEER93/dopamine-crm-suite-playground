{
  "name": "dopamine-pwa",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:smoke": "npm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:android:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "cap:ios:build": "npm run build && npx cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination \"platform=iOS Simulator,name=iPhone 15\" build CODE_SIGNING_ALLOWED=NO",
    "test:vitest": "cross-env NODE_ENV=test node -r ./scripts/windows-spawn-patch.cjs ./node_modules/vitest/vitest.mjs run --watch=false",
    "lint": "eslint .",
    "e2e": "cross-env VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1 npm run build && npx playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/ios": "^8.0.2",
    "@react-google-maps/api": "^2.20.7",
    "idb-keyval": "^6.2.1",
    "picocolors": "^1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/google.maps": "^3.55.9",
    "@types/node": "^20.12.7",
    "@types/react": "18.3.27",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.1",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17"
  }
}
