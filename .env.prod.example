DPM_ENV=production

POSTGRES_DB=dpm_crm
POSTGRES_USER=dpm_user
POSTGRES_PASSWORD=change_me_strong

PROD_DATABASE_URL=postgresql+psycopg2://dpm_user:change_me_strong@db:5432/dpm_crm

JWT_SECRET=change_me_strong
ALLOWED_ORIGINS=https://your-cloudflare-pages-project.pages.dev
ALLOWED_ORIGIN_REGEX=^https://your-cloudflare-pages-project(?:-[a-z0-9-]+)?\.pages\.dev$
SEED_DEFAULT_USERS=false
ALLOW_DEV_TOKEN_ENDPOINT=false
ALLOW_DEV_TOKEN=false
GEOFENCE_ENABLED=true

# Full-stack Docker Compose default: same-origin Caddy proxy to FastAPI.
# Cloudflare Pages field deploys must set this in GitHub Actions to the deployed HTTPS API base URL.
VITE_API_BASE_URL=/api/v1
