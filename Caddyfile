:80 {
  encode gzip
  # Security posture:
  # - This server is intended for private network / Cloudflare Tunnel origin use.
  # - Do not expose :80 directly to the public internet.
  # - When upstream proxy marks an HTTP request, force HTTPS redirect.
  @insecure_proxy header X-Forwarded-Proto http
  redir @insecure_proxy https://{host}{uri} permanent

  # Preserve the /api prefix when proxying to FastAPI (FastAPI mounts routers under /api).
  handle /api/* {
    reverse_proxy backend:8000
  }

  handle_path /pwa/* {
    root * /srv/www/pwa
    try_files {path} /index.html
    file_server
  }

  handle {
    root * /srv/www/crm
    try_files {path} /index.html
    file_server
  }
}
